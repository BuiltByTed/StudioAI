{
  "name": "@builtbyted/studio-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.deploy.json",
    "build": "npm run typecheck && vite build",
    "doctor": "homeframe doctor --root . --dist dist --strict",
    "test": "vitest run && node --test deploy/server.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run doctor"
  },
  "dependencies": {
    "@builtbyted/homeframe": "file:vendor/builtbyted-homeframe-0.1.18-studio.1.tgz",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "katex": "0.18.2",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
